# --- Telegram (get api_id / api_hash from https://my.telegram.org/apps) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Numeric ID of the job-offers group chat. Run `python get_group_id.py` to list yours.
# Supergroup IDs are usually negative, e.g. -1001234567890
TELEGRAM_GROUP_ID=
# Local session file name (created on first login, reused after)
TELEGRAM_SESSION_NAME=job_opportunities_session

# --- Gemini (get a key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Discord (Server Settings > Integrations > Webhooks > New Webhook) ---
DISCORD_WEBHOOK_URL=

# --- Misc ---
DOWNLOAD_DIR=downloads

# --- Batching ---
# Flush to Gemini once this many messages are buffered...
BATCH_SIZE=5
# ...or after this many seconds since the last flush, whichever comes first.
BATCH_INTERVAL_SECONDS=30

# --- Notion mention directory (optional -- leave blank to disable) ---
# Create an internal integration at https://www.notion.so/my-integrations, then share your
# database with it ("..." menu on the database > Connections > add your integration).
NOTION_API_KEY=
# The 32-character ID from the database's URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=
# How long (seconds) to cache the directory before re-fetching from Notion.
NOTION_CACHE_TTL_SECONDS=300
# rapidfuzz partial_ratio score (0-100) required to count as a match. Lower = looser matching.
MENTION_FUZZY_THRESHOLD=87
